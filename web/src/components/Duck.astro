---
interface Props {
    size?: number;
    mood?: "idle" | "happy" | "think" | "no";
    class?: string;
    talk?: boolean;
    label?: string;
    id?: string;
}
const {
    size = 160,
    mood = "idle",
    class: cls = "",
    talk = false,
    label = "Quack, the rubber duck mascot",
    id,
} = Astro.props;
---

<span
    id={id}
    class:list={["duck", cls]}
    data-mood={mood}
    data-talk={talk ? "" : undefined}
    style={`--s:${size}px`}
>
    <svg
        viewBox="0 0 140 130"
        role="img"
        aria-label={label}
        width={size}
        height={size * (130 / 140)}
    >
        <g class="duck-all">
            <g
                class="feet"
                stroke="var(--beak)"
                stroke-width="4"
                stroke-linecap="round"
                fill="none"
            >
                <path d="M54 104v12M47 118h14" />
                <path d="M76 102v14M69 118h14" />
            </g>
            <path
                d="M22 76C10 70 6 58 8 50c10 4 20 10 26 18z"
                fill="var(--duck)"
            />
            <path
                d="M20 80c0-22 22-30 46-28 24 2 38 14 34 32-4 16-30 24-50 22-20-2-30-12-30-26z"
                fill="var(--duck)"
            />
            <path
                class="wing"
                d="M38 78c10-12 32-10 42 2-10 14-32 14-42-2z"
                fill="var(--duck-shade)"
            />
            <g class="head">
                <circle cx="88" cy="42" r="24" fill="var(--duck)" />
                <path
                    d="M80 19c2-9 12-11 16-5-6-1-10 1-11 6z"
                    fill="var(--duck)"
                />
                <path
                    d="M106 40c14-2 24 2 22 9-4 6-16 5-24 2z"
                    fill="var(--beak)"
                />
                <path
                    d="M105 47c7 2 14 2 20 0"
                    stroke="var(--duck-ink)"
                    stroke-opacity=".35"
                    stroke-width="1.5"
                    fill="none"
                    stroke-linecap="round"
                />
                <g class="eye-open">
                    <circle cx="94" cy="36" r="5.4" fill="#fff" />
                    <circle
                        class="pupil"
                        cx="95"
                        cy="36"
                        r="2.9"
                        fill="var(--duck-ink)"
                    />
                    <ellipse
                        class="lid"
                        cx="94"
                        cy="36"
                        rx="5.8"
                        ry="5.8"
                        fill="var(--duck)"
                    />
                </g>
                <path
                    class="eye-happy"
                    d="M89 38q5-7 10 0"
                    stroke="var(--duck-ink)"
                    stroke-width="2.4"
                    fill="none"
                    stroke-linecap="round"
                />
                <path
                    class="eye-no"
                    d="M90 32l8 8M98 32l-8 8"
                    stroke="var(--duck-ink)"
                    stroke-width="2.4"
                    fill="none"
                    stroke-linecap="round"
                />
            </g>
        </g>
    </svg>
    {talk && (
        <span class="bubble" role="status" aria-live="polite" hidden></span>
    )}
</span>

<style is:global>
    .duck {
        --duck: #f2b705;
        --duck-shade: #c98f00;
        --beak: #e8590c;
        --duck-ink: #1b1a17;
        display: inline-block;
        position: relative;
        line-height: 0;
    }
    .duck svg {
        display: block;
        overflow: visible;
    }
    .duck .eye-happy,
    .duck .eye-no {
        display: none;
    }
    .duck[data-mood="happy"] .eye-open,
    .duck[data-mood="no"] .eye-open {
        display: none;
    }
    .duck[data-mood="happy"] .eye-happy,
    .duck[data-mood="no"] .eye-no {
        display: inline;
    }
    .duck .lid {
        transform-box: fill-box;
        transform-origin: center top;
        transform: scaleY(0);
        animation: blink 5.5s infinite;
    }
    .duck .head {
        transform-box: view-box;
        transform-origin: 80px 60px;
        transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
    }
    .duck[data-mood="think"] .head {
        transform: rotate(-7deg);
    }
    .duck[data-mood="no"] .head {
        animation: shake 0.5s;
    }
    .duck .duck-all {
        transform-box: view-box;
        transform-origin: 70px 118px;
        animation: bob 4.8s ease-in-out infinite;
    }
    .duck[data-talk] {
        cursor: pointer;
    }
    .duck[data-talk]:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 6px;
        border-radius: 8px;
    }
    .duck .bubble {
        position: absolute;
        left: 62%;
        bottom: 92%;
        width: max-content;
        max-width: 230px;
        line-height: 1.4;
        padding: 0.55rem 0.75rem;
        background: var(--ink);
        color: var(--paper);
        font: 500 0.8rem/1.4 var(--mono);
        border-radius: 10px 10px 10px 2px;
        z-index: 5;
        text-align: left;
    }
    .duck .bubble[hidden] {
        display: none;
    }
    @keyframes blink {
        0%,
        93%,
        100% {
            transform: scaleY(0);
        }
        96% {
            transform: scaleY(1);
        }
    }
    @keyframes bob {
        0%,
        100% {
            transform: translateY(0) rotate(0);
        }
        50% {
            transform: translateY(-3px) rotate(-1deg);
        }
    }
    @keyframes shake {
        0%,
        100% {
            transform: rotate(0);
        }
        20% {
            transform: rotate(-9deg);
        }
        50% {
            transform: rotate(8deg);
        }
        80% {
            transform: rotate(-5deg);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .duck .lid,
        .duck .duck-all,
        .duck[data-mood="no"] .head {
            animation: none;
        }
    }
</style>
